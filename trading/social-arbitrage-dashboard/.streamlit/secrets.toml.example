# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml is gitignored — NEVER commit real credentials.
#
# On Render/Heroku, set these as environment variables instead (the app reads
# either st.secrets or os.environ — no code change needed).

SECURITY_USERNAME = "PASTE_HERE"
