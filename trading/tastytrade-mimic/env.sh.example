# Deploy-target environment for tt-mimic. TEMPLATE ONLY — no real values here.
#
#   cp env.sh.example env.sh   # then fill in the PASTE_HERE values
#   chmod 600 env.sh           # lock it down
#
# env.sh is gitignored and must NEVER be committed. A secret that touches a
# chat, commit, bus message, or screenshot is BURNED — regenerate it before
# use. This module never logs secret values, only their names.

# --- required ---
export TT_CLIENT_SECRET=PASTE_HERE      # tastytrade OAuth app client secret
export TT_REFRESH_TOKEN=PASTE_HERE      # tastytrade OAuth refresh token
export TELEGRAM_BOT_TOKEN=PASTE_HERE    # @BotFather bot token
export TELEGRAM_CHAT_ID=PASTE_HERE      # your chat id (from getUpdates)

# --- safety posture (leave as paper until you've watched a full paper cycle) ---
export MODE=paper                       # paper -> sandbox; live -> production

# --- optional ---
# export TT_ACCOUNT=                     # defaults to first account on the login
# export MAX_CONTRACTS=1                 # cap on the largest leg per copied trade
# export APPROVAL_TIMEOUT_S=900          # unanswered approval expires to SKIP
# export KILL_SWITCH_FILE=./KILL_SWITCH  # touch this file to halt all trading
# Map follow-feed trader ids to display names shown on the approval card:
export TRADER_NAMES_JSON='{"36625": "Tom Preston"}'
