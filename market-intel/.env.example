# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Missing config is reported by NAME; values are never logged or printed.

# --- database ---------------------------------------------------------------
MI_DATABASE_URL=sqlite:///data/dev.db
# production target: postgresql://user:pass@localhost:5432/marketintel

# --- collectors -------------------------------------------------------------
# SEC requires a declared contact in the User-Agent. Requests without one are
# blocked by sec.gov, so the transport refuses to start without it.
MI_USER_AGENT=MarketIntel/1.0 (you@example.com)

# Force fixture mode: runs the real collectors against recorded payloads.
MI_OFFLINE=0

# --- api --------------------------------------------------------------------
MI_PORT=8787
MI_HTTP_LOG=0

# --- future providers (none wired yet; see docs/DATA_CATALOG.md) ------------
# FRED_API_KEY=
# MARKET_DATA_API_KEY=
# NEWS_API_KEY=
