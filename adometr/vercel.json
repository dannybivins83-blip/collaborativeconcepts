{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/adometr", "destination": "/", "permanent": false },
    { "source": "/adometr/:path*", "destination": "/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://collaborativeconceptsfl.com/api/:path*" }
  ]
}
