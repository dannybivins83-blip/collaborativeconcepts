{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/ai", "destination": "/solutions", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/", "has": [{ "type": "host", "value": "wwslgc.collaborativeconceptsfl.com" }], "destination": "/wwslgc/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "wwslgc.collaborativeconceptsfl.com" }], "destination": "/wwslgc/:path*" },
    { "source": "/", "has": [{ "type": "host", "value": "casadelmonte.collaborativeconceptsfl.com" }], "destination": "/lagala/casadelmonte/index.html" },
    { "source": "/portal", "has": [{ "type": "host", "value": "casadelmonte.collaborativeconceptsfl.com" }], "destination": "/lagala/casadelmonte/portal.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "casadelmonte.collaborativeconceptsfl.com" }], "destination": "/lagala/casadelmonte/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)\\.(html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
