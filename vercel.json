        }
      ],
      "destination": "https://wwslgc.collaborativeconceptsfl.com/admin/:path*",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "roofanchorcert.com"
        }
      ],
      "destination": "https://wwslgc.collaborativeconceptsfl.com/admin",
      "permanent": false
    },
    {
      "source": "/portal/:path*",
      "has": [
        {
          "type": "host",
          "value": "roofanchorcert.com"
        }
      ],
      "destination": "https://wwslgc.collaborativeconceptsfl.com/portal/:path*",
      "permanent": false
