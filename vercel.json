      "destination": "/adometr",
      "permanent": false
    },
    {
      "source": "/adometer/:path*",
      "destination": "/adometr/:path*",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.adometr.com"
        }
      ],
      "destination": "https://adometr.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.adometr.com"
        }
      ],
      "destination": "https://adometr.com/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/verify/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wwslgc.collaborativeconceptsfl.com"
        }
      ],
      "destination": "/wwslgc/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wwslgc.collaborativeconceptsfl.com"
        }
      ],
      "destination": "/wwslgc/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "roofanchorcert.com"
        }
      ],
      "destination": "/wwslgc/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "adometr.com"
        }
      ],
      "destination": "/adometr/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "adometr.com"
        }
      ],
      "destination": "/adometr/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|gif|ico|svg|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}