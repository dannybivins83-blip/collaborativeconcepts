{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.collaborativeconceptsfl.com"
        }
      ],
      "destination": "https://collaborativeconceptsfl.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.collaborativeconceptsfl.com"
        }
      ],
      "destination": "https://collaborativeconceptsfl.com/:path*",
      "permanent": true
    },
    {
