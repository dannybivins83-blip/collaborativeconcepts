{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.collaborativeconceptsfl.com"
        }
      ],
      "destination": "https://collaborativeconceptsfl.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.collaborativeconceptsfl.com"
        }
      ],
      "destination": "https://collaborativeconceptsfl.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wwslgc.collaborativeconceptsfl.com"
        }
      ],
      "destination": "/wwslgc",
      "permanent": true
    },
    {
      "source": "/wwslgc",
      "has": [
        {
          "type": "host",
          "value": "collaborativeconceptsfl.com"
        }
      ],
      "destination": "https://wwslgc.collaborativeconceptsfl.com/wwslgc",
      "permanent": true
    },
    {
      "source": "/wwslgc/:path*",
      "has": [
        {
          "type": "host",
          "value": "collaborativeconceptsfl.com"
        }
      ],
      "destination": "https://wwslgc.collaborativeconceptsfl.com/:path*",
      "permanent": true
    },
    {
      "source": "/ai",
      "destination": "/solutions",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/verify/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wwslgc.collaborativeconceptsfl.com"
        }
      ],
      "destination": "/wwslgc/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wwslgc.collaborativeconceptsfl.com"
        }
      ],
      "destination": "/wwslgc/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|gif|ico|svg|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
