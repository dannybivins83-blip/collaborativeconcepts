      "has": [
        {
          "type": "host",
          "value": "collaborativeconceptsfl.com"
        }
      ],
      "destination": "https://palmbeachwakeboats.com/",
      "permanent": true
    },
    {
      "source": "/wake/:path*",
      "has": [
